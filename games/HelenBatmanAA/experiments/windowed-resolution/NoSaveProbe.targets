<Project xmlns="http://schemas.microsoft.com/developer/msbuild/2003">
  <!-- Throwaway opt-in source substitution. No normal project imports this file. -->
  <PropertyGroup>
    <OutDir>$(NoSaveOutput)\native\</OutDir>
    <IntDir>$(NoSaveOutput)\obj\$(MSBuildProjectName)\</IntDir>
  </PropertyGroup>
  <ItemGroup Condition="'$(MSBuildProjectName)' == 'HelenRuntime'">
    <ClCompile Remove="BatmanGraphicsSessionService.cpp" />
    <ClCompile Include="$(NoSaveOutput)\BatmanGraphicsSessionService.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)NoSaveResolutionProbe.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)NoSaveVsyncRequest.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)NoSaveFullscreenModes.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(MSBuildProjectName)' == 'HelenRuntime'">
    <ClCompile>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory);%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemDefinitionGroup Condition="'$(EnableSameSizeRefresh)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>HELEN_ENABLE_STARTUP_HOOKS;HELEN_ENABLE_SAME_SIZE_REFRESH;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\vsync-refresh;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(EnableSameSizeRefresh)' == 'true' and '$(MSBuildProjectName)' == 'HelenRuntime'">
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\SameSizeRefresh.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\AnchoredResize.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\RefreshActivation.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\RefreshRequest.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\ActivationMatcher.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\DecisionBridge.cpp" />
  </ItemGroup>
  <ItemGroup Condition="'$(EnableSameSizeRefresh)' == 'true' and '$(MSBuildProjectName)' == 'HelenGameHook'">
    <ClCompile Include="$(MSBuildThisFileDirectory)..\..\..\..\HelenGameHook\StartupHookRuntime.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\vsync-refresh\InstallSameSizeRefresh.cpp" />
  </ItemGroup>
  <ItemDefinitionGroup Condition="'$(EnableBloomReload)' == 'true'">
    <ClCompile>
      <PreprocessorDefinitions>HELEN_ENABLE_BLOOM_RELOAD;%(PreprocessorDefinitions)</PreprocessorDefinitions>
      <AdditionalIncludeDirectories>$(MSBuildThisFileDirectory)..\bloom-reload;%(AdditionalIncludeDirectories)</AdditionalIncludeDirectories>
    </ClCompile>
  </ItemDefinitionGroup>
  <ItemGroup Condition="'$(EnableBloomReload)' == 'true' and '$(MSBuildProjectName)' == 'HelenRuntime'">
    <ClCompile Include="$(MSBuildThisFileDirectory)..\bloom-reload\BloomDraft.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\bloom-reload\BloomEffectBinding.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\bloom-reload\BloomIniBinding.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\bloom-reload\BloomOverlayEdit.cpp" />
    <ClCompile Include="$(MSBuildThisFileDirectory)..\bloom-reload\BloomReloadProbe.cpp" />
  </ItemGroup>
</Project>
